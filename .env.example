# Copy to `.env` and fill in. The `.env` file is gitignored.
# The core pipeline (signals + scoring + thesis) runs fully offline with no keys.

# --- LLM (only needed for `gravity agent`, the LangGraph tool-calling mode) ---
# Any OpenAI-compatible endpoint works. Defaults to the public OpenAI API.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- HTTP service auth (only for `gravity serve`) ---
# When set, POST /analyze requires the X-API-Key header.
GRAVITY_API_KEY=

# --- Azure integrations (production; read via managed identity) ---
# AZURE_KEY_VAULT_URL=https://<vault>.vault.azure.net/
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_DB=gravitytrade
# COSMOS_CONTAINER=signals
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# --- Optional tracing (LangSmith) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=gravity-trade-agent
